# Variáveis lidas pelo docker-compose.yml (ficam na RAIZ do repositório).
# Copie para ".env" (já está no .gitignore) e ajuste.

# Pasta do SERVIDOR com os documentos que o assistente pode ler.
# Windows (use barras normais): DOCS_ROOT=D:/Documentos
# O backend a enxerga como /dados (somente leitura).
DOCS_ROOT=./documentos
