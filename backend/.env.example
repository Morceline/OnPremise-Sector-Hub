# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" real (ele já está no .gitignore).

# --- Infraestrutura local ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
OLLAMA_HOST=http://host.docker.internal:11434

LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- Chave do gestor (RF04) ---
# Gere o hash com:
#   python -c "import hashlib; print(hashlib.sha256(b'SUA_CHAVE_AQUI').hexdigest())"
MANAGER_KEY_HASH=

# --- Feedback por e-mail ---
FEEDBACK_ENABLED=true
FEEDBACK_EMAIL_TO=seu-email@empresa.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Limites (ajuste para máquinas mais fracas/fortes) ---
MAX_FILE_SIZE_MB=25
MAX_WEB_FETCH_CHARS=20000
REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=15
